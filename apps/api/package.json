{
  "name": "@forgeline/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:worker": "APP_ROLE=worker node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --config jest.config.js --selectProjects unit",
    "test:integration": "dotenv -e ../../.env -- jest --config jest.config.js --selectProjects integration --runInBand",
    "test:all": "dotenv -e ../../.env -- jest --config jest.config.js --runInBand"
  },
  "dependencies": {
    "@forgeline/ai": "workspace:*",
    "@forgeline/database": "workspace:*",
    "@forgeline/integrations": "workspace:*",
    "@forgeline/shared": "workspace:*",
    "@forgeline/workflow-engine": "workspace:*",
    "@langchain/core": "^1.2.14",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cron": "4.4.0",
    "diff": "^8.0.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "tar": "^7.4.3",
    "zod": "^4.1.0"
