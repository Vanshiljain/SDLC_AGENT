# ─────────────────────────────────────────────────────────────────────────────
# Forgeline configuration. Copy to `.env` and fill in values.
# Generate secrets with:  openssl rand -base64 48   (JWT)  /  openssl rand -base64 32  (encryption key)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=development
# api | worker | all  (all = HTTP API + background workers in one process)
APP_ROLE=all
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173
# Comma-separated allowed browser origins (defaults to WEB_APP_URL)
CORS_ORIGINS=
LOG_LEVEL=info
# Set true when running behind a reverse proxy / load balancer
TRUST_PROXY=false

# ── Data stores ──
DATABASE_URL=postgresql://forgeline:forgeline@localhost:5432/forgeline?schema=public
REDIS_URL=redis://localhost:6379
# bullmq (durable, production) | inline (single process, tests)
QUEUE_DRIVER=bullmq
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=forgeline_knowledge

# ── AI (OpenAI via LangChain) ──
OPENAI_API_KEY=
# Optional: Azure/OpenAI-compatible gateway
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4.1
# Optional per-role overrides
OPENAI_MODEL_PLANNER=
OPENAI_MODEL_CODER=
OPENAI_MODEL_REVIEWER=
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Leave empty for model default (reasoning models ignore temperature)
OPENAI_TEMPERATURE=
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2

# ── Auth & security ──
# Must be at least 32 chars and different from each other
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=14
# true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Versioned AES-256-GCM data keys "version:base64(32 bytes)". Add a new highest version to rotate.
ENCRYPTION_KEYS=1:REPLACE_WITH_BASE64_32_BYTE_KEY
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── GitHub (OAuth App; PAT connections work without these) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# ── Jira / Atlassian (OAuth 2.0 3LO; API-token connections work without these) ──
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
ATLASSIAN_AUTH_URL=https://auth.atlassian.com
ATLASSIAN_API_URL=https://api.atlassian.com

# ── Notion (public integration OAuth; internal tokens work without these) ──
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_API_URL=https://api.notion.com/v1

# ── Trello ──
TRELLO_API_KEY=
# Used to verify Trello webhook signatures
TRELLO_API_SECRET=
TRELLO_API_URL=https://api.trello.com/1
TRELLO_WEB_URL=https://trello.com

# ── Sandbox for lint/typecheck/test execution ──
# docker (production) | local (development only) | disabled (validation reported as "not run")
SANDBOX_DRIVER=disabled
SANDBOX_DEFAULT_IMAGE=node:22-bookworm
SANDBOX_WORKDIR=/tmp/forgeline-sandbox
SANDBOX_TIMEOUT_MS=900000
SANDBOX_MEMORY_MB=4096
SANDBOX_CPUS=2
# bridge allows package installation; none fully isolates the network
SANDBOX_NETWORK=bridge

# ── Outbound HTTP (health checks, smoke tests, HTTP node) ──
# Allow requests to private networks (internal environments). Keep false unless needed.
OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
# Hostnames always allowed even if they resolve to private addresses
OUTBOUND_ALLOWED_HOSTS=

# ── Product ──
DEMO_MODE_ENABLED=true
SWAGGER_ENABLED=false

# ── Observability ──
METRICS_ENABLED=true
# If set, /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=
SENTRY_DSN=
WORKER_CONCURRENCY=8

# ── Web app (Vite) ──
VITE_API_URL=http://localhost:4000
