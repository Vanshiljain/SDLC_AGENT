// Forgeline — primary relational schema.
//
// Conventions
//  * UUID primary keys, createdAt/updatedAt timestamps.
//  * Every tenant-owned row carries organizationId (tenant isolation) and is indexed on it.
//  * deletedAt = soft delete for user-facing entities.
//  * Secrets are never stored in plain text: IntegrationCredential.ciphertext (AES-256-GCM).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

